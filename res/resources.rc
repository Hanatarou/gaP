// Icon, manifest and version information of gaP. Compiled by build.rs (rc.exe with MSVC, windres with MinGW).
// The constants are written out so the file needs no Windows SDK header.
// The file names are relative to this folder (build.rs makes them absolute for the compiler).

#pragma code_page(65001)

1 ICON "icon.ico"
1 24 "gap.manifest"

1 VERSIONINFO
 FILEVERSION 2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Bruno Eduardo"
            VALUE "Comments", "gaP: great! another Portabilizer"
            VALUE "FileDescription", "gaP: great! another Portabilizer"
            VALUE "FileVersion", "2.1.0.0"
            VALUE "InternalName", "gaP"
            VALUE "LegalCopyright", "Copyright (c) 2015-2026 Bruno Eduardo"
            VALUE "OriginalFilename", "gaP.exe"
            VALUE "ProductName", "gaP: great! another Portabilizer"
            VALUE "ProductVersion", "2.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
