		Local $AboutLabel4 = GUICtrlCreateLabel("Author: Aeolis", 8, 79, 71, 21)
		Local $AboutLabel5 = GUICtrlCreateLabel("Collaborators: tproli and all The Portable Freeware Collection Forums members", 8, 102, 380, 13)
		Local $AboutLabel6 = GUICtrlCreateLabel("Credits: AutoIt creators and all AutoIt Forums members", 8, 125, 380, 13)
