;===============================================================================================================
; Function:		CreateShellFolders()
;===============================================================================================================
Func CreateShellFolders()
	Global $ShellFArray[38]
	_ArrayColInsert($ShellFArray, 1)
	$ShellFArray[0][0] = 37
	$ShellFArray[1][0] = "Administrative Tools"
	$ShellFArray[2][0] = "AppData"
	$ShellFArray[3][0] = "Cache"
	$ShellFArray[4][0] = "CD Burning"
	$ShellFArray[5][0] = "Cookies"
	$ShellFArray[6][0] = "Desktop"
	$ShellFArray[7][0] = "Documents"
	$ShellFArray[8][0] = "Favorites"
	$ShellFArray[9][0] = "Fonts"
	$ShellFArray[10][0] = "History"
	$ShellFArray[11][0] = "Local AppData"
	$ShellFArray[12][0] = "MyDocuments"
	$ShellFArray[13][0] = "My Music"
	$ShellFArray[14][0] = "My Pictures"
	$ShellFArray[15][0] = "My Video"
	$ShellFArray[16][0] = "NetHood"
	$ShellFArray[17][0] = "Personal"
	$ShellFArray[18][0] = "PrintHood"
	$ShellFArray[19][0] = "Programs"
	$ShellFArray[20][0] = "Recent"
	$ShellFArray[21][0] = "SendTo"
	$ShellFArray[22][0] = "Start Menu"
	$ShellFArray[23][0] = "Startup"
	$ShellFArray[24][0] = "Templates"
	$ShellFArray[25][0] = "Common Administrative Tools"
	$ShellFArray[26][0] = "Common AppData"
	$ShellFArray[27][0] = "Common Desktop"
	$ShellFArray[28][0] = "Common Documents"
	$ShellFArray[29][0] = "Common Favorites"
	$ShellFArray[30][0] = "Common Programs"
	$ShellFArray[31][0] = "Common Start Menu"
	$ShellFArray[32][0] = "Common Startup"
	$ShellFArray[33][0] = "Common Templates"
	$ShellFArray[34][0] = "CommonMusic"
	$ShellFArray[35][0] = "CommonPictures"
	$ShellFArray[36][0] = "CommonVideo"
	$ShellFArray[37][0] = "OEM Links"
	For $ShellFArrayi = 1 To 24
		$ShellFArray[$ShellFArrayi][1] = RegRead("HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders", $ShellFArray[$ShellFArrayi][0])
	Next
	For $ShellFArrayi = 25 To $ShellFArray[0][0]
		$ShellFArray[$ShellFArrayi][1] = RegRead("HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders", $ShellFArray[$ShellFArrayi][0])
	Next
	Global $CommonAppData = $ShellFArray[26][1] & "\"
EndFunc   ;==>CreateShellFolders
