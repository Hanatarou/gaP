			MainAppIni()
			;
			CmdLineIni()
			;
			MainAppWorkDirIni()
			;
			MultipleInstIni()
			;
			DebugLogIni()
			;
			IsAdminIni()
			;
			DotNetIni()
			;
			JavaFullIni()
			;
			OnlineIni()
			;
			OSIni()
			;
			WaitIni()
			;
		Else
			Select
				Case $IsReadOnly = 0
					Local $IniNotFound = MsgBox(33, $gapTitle, "No "".ini"" file found. Do you want to create a new one?")
					If $IniNotFound = 1 Then FileInstall("G:\Arquivos Auxiliares\Manuten��o e Diagn�stico\[Meus Programas]\gaP\Modules\Ini\gaP.ini", $gapIniFilePath, 0)
