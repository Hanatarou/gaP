;===============================================================================================================
; Function:		hour122() - {h}
;===============================================================================================================
Func hour122()
	Local $hour122F = StringFormat("%02s", hour121())
	Return $hour122F
EndFunc   ;==>hour122
;
;===============================================================================================================
; Function:		hour121() - {g}
;===============================================================================================================
Func hour121()
	Local $hour121F = StringLeft(@HOUR, 1)
	If $hour121F = 0 Then
		$hour121F = StringRight(@HOUR, 1)
	Else
		$hour121F = @HOUR
	EndIf
	If $hour121F = 0 Then $hour121F = 12
	If $hour121F >= 13 And $hour121F <= 23 Then $hour121F = $hour121F - 12
	Return $hour121F
EndFunc   ;==>hour121
