; Program Entry Point

Switch $CmdLineRaw
	Case "-crypt"
		; Encryption and Decryption Module GUI - Start
		Opt("GUIOnEventMode", 1)
		Local $CryptModule = GUICreate("Encryption and Decryption Module - " & $ProgramName, 530, 210, -1, -1)
		GUISetBkColor(0xFFFFFF, $CryptModule)
		Local $Passwordbox = GUICtrlCreateInput("Write the password to encrypt or decrypt here.", 70, 16, 270, 21)
		Local $PasswordBoxLabel = GUICtrlCreateLabel("Password:", 8, 18, 56, 17)
		Local $ComboBox1 = GUICtrlCreateCombo("", 360, 16, 161, 25, BitOR(0x0002,0x0040))
		Local $ComBox1List = GUICtrlSetData($ComboBox1, "Encrypt|Decrypt", "Encrypt")
		Local $InputBox1 = GUICtrlCreateInput("Write the text to encrypt or decrypt here.", 70, 48, 451, 21)
		Local $InputBox1Label = GUICtrlCreateLabel("Input text:", 8, 50, 60, 17)
		Local $InputBox2 = GUICtrlCreateInput("Read the encrypted or decrypted text here.", 70, 80, 451, 21, 0)
		Local $InputBox2Label = GUICtrlCreateLabel("Output text:", 8, 82, 60, 17)
		Local $InputBox2Color = GUICtrlSetBkColor($InputBox2, 0xFFFFE1)
		Local $InputBox2State = GUICtrlSetState($InputBox2, 128)
		Local $ClipboardButton = GUICtrlCreateButton("Copy to clipboard", 392, 112, 129, 85)
		Local $WarningLabel = GUICtrlCreateLabel("WARNING: This encryption module uses AES 256 bit algorithm to encrypt or decrypt your data. There is no perfect encryption available and gaP encryption and decryption module IS NOT an exception. However, choosing a strong password will make decoding very hard for the average computer user." & @CRLF & @CRLF & "WARNING: Even if you launch the main application with encrypted command line parameters, gaP will pass unencrypted data to the application which may be visible to other applications.", 8, 110, 370, 90)
		Local $WarningLabelFont = GUICtrlSetFont($WarningLabel, 7, 700)
