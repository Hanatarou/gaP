;===============================================================================================================
; Function:		ReadOnlyIni()
;===============================================================================================================
Func ReadOnlyIni()
	Local $ReadOnlyCheck = FileOpen(@ScriptDir & "\@#$readonly@#$", 9)
	If $ReadOnlyCheck = -1 Then
		$IsReadOnly = 1
		Local $ReadOnly = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "!readonly", "1"))
		Select
			Case $ReadOnly = -2
				CleanMUICache()
				CleanAppPaths()
				Exit

			Case $ReadOnly = -1
				MsgBox(64, $gapTitle, Chr(34) & $gapExeName & ".exe" & Chr(34) & " is running from a read only drive. " & _
				"Some applications may not work as expected in this mode. " & Chr(34) & $gapExeName & ".exe" & Chr(34) & " will " & _
				"not be able to update configuration changes in files stored in a read only drive.")
				CleanMUICache()
				CleanAppPaths()
				Exit

			Case $ReadOnly = 1
				MsgBox(64, $gapTitle, Chr(34) & $gapExeName & ".exe" & Chr(34) & " is running from a read only drive. " & _
				"Some applications may not work as expected in this mode. " & Chr(34) & $gapExeName & ".exe" & Chr(34) & " will " & _
				"not be able to update configuration changes in files stored in a read only drive.")

		EndSelect
	Else
		FileClose($ReadOnlyCheck)
		FileDelete(@ScriptDir & "\@#$readonly@#$")
		$IsReadOnly = 0
	EndIf
EndFunc   ;==>ReadOnlyIni
;
;===============================================================================================================
; Function:		DebugLogIni()
;===============================================================================================================
Func DebugLogIni()
	Global $DebugLog = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "!debug", "0"))
	If $gaPFirstInstance = 0 Then $DebugLog = 0
	If $DebugLog = 1 Then
		If $IsReadOnly = 0 Then
			DirCreate(@ScriptDir & "\Logs")
			Local $DebugLogFileName = $gapExeName & "_" & @YEAR & "." & @MON & "." & @MDAY & "." & @HOUR & "." & @MIN & "." & @SEC & "." & "log"
			Global $DebugLogFile = @ScriptDir & "\Logs\" & $DebugLogFileName
		EndIf
		If $IsReadOnly = 1 Then
			DirCreate($CommonAppData & "gaPLogs")
			Local $DebugLogFileName = $gapExeName & "_" & @AutoItPID & "_" & @YEAR & "." & @MON & "." & @MDAY & "." & @HOUR & "." & @MIN & "." & @SEC & "." & "log"
			Global $DebugLogFile = $CommonAppData & "gaPLogs\" & $DebugLogFileName
		EndIf
		Local $DebugLogFileOpen = FileOpen($DebugLogFile, 9)
		If $DebugLogFileOpen <> -1 Then
			FileWriteLine($DebugLogFileOpen, "######################gaP Log Header######################")
			FileWriteLine($DebugLogFileOpen, StringFormat("%-57s", "#  Date(DD/MM/YYYY - HH:MM:SS): " & @MDAY & "/" & @MON & "/" & @YEAR & " - " & @HOUR & ":" & @MIN & ":" & @SEC) & "#")
			FileWriteLine($DebugLogFileOpen, StringFormat("%-57s", "#  gaP Version: " & $ProgramVersion) & "#")
			FileWriteLine($DebugLogFileOpen, StringFormat("%-57s", "#  Host OS: " & StringReplace(StringReplace(@OSVersion, "WIN_", "Windows ", 0, 0), "81", "8.1", 0, 0)) & "#")
			FileWriteLine($DebugLogFileOpen, StringFormat("%-57s", "#  Host Architecture: " & StringLower(@OSArch)) & "#")
			FileWriteLine($DebugLogFileOpen, "######################gaP Log Header######################")
			FileWriteLine($DebugLogFileOpen, @CRLF)
		EndIf
		DebugLogWrite("MAINPROGRAM", "[Shell Folders]", 0, 0)
		DebugLogWrite("MAINPROGRAM", $ShellFArray, 1, 1)
		FileClose($DebugLogFileOpen)
	EndIf
EndFunc   ;==>DebugLogIni
;
;===============================================================================================================
; Function:		DebugLogWrite()
;===============================================================================================================
Func DebugLogWrite($dlwFCaller, $dlwFInput, $dlwFIsArray, $dlwFAddLine)
	If $dlwFCaller = "MAINPROGRAM" Then
		Local $DebugLogFileOpen = FileOpen($DebugLogFile, 9)
		If $DebugLogFileOpen <> -1 Then
			If $dlwFIsArray = 0 Then
				FileWriteLine($DebugLogFileOpen, $dlwFInput)
			Else
				_FileWriteFromArray($DebugLogFileOpen, $dlwFInput, 1)
			EndIf
			If $dlwFAddLine = 1 Then FileWriteLine($DebugLogFileOpen, @CRLF)
		EndIf
		FileClose($DebugLogFileOpen)
	Else
		Local $dlwFError = MsgBox(64, $gapTitle, "The ""DebugLogWrite"" function can't be called from the """ & $dlwFCaller & """ section.")
	EndIf
EndFunc   ;==>DebugLogWrite
;
;===============================================================================================================
; Function:		JavaEarlyIni()
;===============================================================================================================
Func JavaEarlyIni()
	If @OSArch = "x86" Then Global $JavaCurrent = RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\JavaSoft\Java Runtime Environment", "CurrentVersion")
	If @OSArch = "x64" Then Global $JavaCurrent = RegRead("HKEY_LOCAL_MACHINE64\SOFTWARE\JavaSoft\Java Runtime Environment", "CurrentVersion")
	If $JavaCurrent = "" And @OSArch = "x64" Then $JavaCurrent = RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\JavaSoft\Java Runtime Environment", "CurrentVersion")
	$JavaCurrent = StringRegExp($JavaCurrent, "(?i)\d\.\d", 1)
	If $JavaCurrent <> 0 Then
		If @OSArch = "x86" Then Local $JavaExe = RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\JavaSoft\Java Runtime Environment\" & $JavaCurrent[0], "JavaHome")
		If @OSArch = "x64" Then Local $JavaExe = RegRead("HKEY_LOCAL_MACHINE64\SOFTWARE\JavaSoft\Java Runtime Environment\" & $JavaCurrent[0], "JavaHome")
		If $JavaExe = "" And @OSArch = "x64" Then $JavaExe = RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\JavaSoft\Java Runtime Environment\" & $JavaCurrent[0], "JavaHome")
		If $JavaExe = "" Then
			$JavaExe = "There is no Java Runtime Environment installed."
		Else
			$JavaExe = $JavaExe & "\javaw.exe"
		EndIf
	Else
		Local $JavaExe = "There is no Java Runtime Environment installed."
	EndIf
	addvar("MAINPROGRAM", "JAVAEXE", $JavaExe, "V")
EndFunc   ;==>JavaEarlyIni
;
;===============================================================================================================
; Function:		JavaFullIni()
;===============================================================================================================
Func JavaFullIni()
	Local $Java = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "!java", ""))
	If Not $Java = "" Then
		Local $JavaVersions = "EMPTY"
		If @OSArch = "x86" Then Local $Java6 = RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\JavaSoft\Java Runtime Environment", "Java6FamilyVersion")
		If @OSArch = "x64" Then Local $Java6 = RegRead("HKEY_LOCAL_MACHINE64\SOFTWARE\JavaSoft\Java Runtime Environment", "Java6FamilyVersion")
		If $Java6 = "" And @OSArch = "x64" Then $Java6 = RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\JavaSoft\Java Runtime Environment", "Java6FamilyVersion")
		If @OSArch = "x86" Then Local $Java7 = RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\JavaSoft\Java Runtime Environment", "Java7FamilyVersion")
		If @OSArch = "x64" Then Local $Java7 = RegRead("HKEY_LOCAL_MACHINE64\SOFTWARE\JavaSoft\Java Runtime Environment", "Java7FamilyVersion")
		If $Java7 = "" And @OSArch = "x64" Then $Java7 = RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\JavaSoft\Java Runtime Environment", "Java7FamilyVersion")
		$Java6 = StringRegExp($Java6, "(?i)\d\.\d", 1)
		$Java7 = StringRegExp($Java7, "(?i)\d\.\d", 1)
		If $Java6 <> 0 Then	Local $JavaVersions = $JavaVersions & "," & $Java6[0]
		If $Java7 <> 0 Then	Local $JavaVersions = $JavaVersions & "," & $Java7[0]
		If $JavaCurrent <> 0 Then Local $JavaCurrentAlreadyExits = StringInStr($JavaVersions, $JavaCurrent[0], 0)
		If $JavaCurrent <> 0 And $JavaCurrentAlreadyExits = 0 Then Local $JavaVersions = $JavaVersions & "," & $JavaCurrent[0]
		Local $JavaExit = StringInStr($Java, "!", 0)
		$Java = StringReplace($Java, "!", "", 0)
		Local $JavaCheck = StringInStr($JavaVersions, $Java, 0)
		If $JavaCheck = 0 And $JavaExit = 0 Then MsgBox(64, $gapTitle, "The main application requires Java Runtime Environment version " & $Java & " to run.")
		If $JavaCheck = 0 And $JavaExit > 0 Then
			MsgBox(64, $gapTitle, "The main application requires Java Runtime Environment version " & $Java & " to run.")
			Exit
		EndIf
	EndIf
EndFunc   ;==>JavaFullIni
;
;===============================================================================================================
; Function:		MainAppIni()
;===============================================================================================================
Func MainAppIni()
	Global $MainApp = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "application", ""))
	Global $MainAppShowState = @SW_SHOW
	If $MainApp = "" Or $MainApp = "NULL" Then
		MsgBox(64, $gapTitle, "You MUST define a main application path in the ""GENERAL"" section.")
		Exit
	Else
		Local $MainAppTemp = StringSplit($MainApp, " :: ", 1)
		If $MainAppTemp[0] > 3 Then
			MsgBox(64, $gapTitle, "Check the main application path input data.")
			Exit
		EndIf
		If $MainAppTemp[0] = 3 Then
			If $MainAppTemp[3] = "hide" Then $MainAppShowState = @SW_HIDE
			If $MainAppTemp[3] = "min" Then $MainAppShowState = @SW_MINIMIZE
			If $MainAppTemp[3] = "max" Then $MainAppShowState = @SW_MAXIMIZE
			If @OSArch = "x64" Then
				Local $MainAppx64 = _PathFull($MainAppTemp[2], @ScriptDir)
				If Not FileExists($MainAppx64) Then
					Local $MainAppx86 = _PathFull($MainAppTemp[1], @ScriptDir)
					If Not FileExists($MainAppx86) Then
						MsgBox(64, $gapTitle, "The main application (x86) path and (x64) path are invalid.")
						Exit
					Else
						$MainApp = $MainAppx86
					EndIf
				Else
					$MainApp = $MainAppx64
				EndIf
			EndIf
			If @OSArch = "x86" Then
				Local $MainAppx86 = _PathFull($MainAppTemp[1], @ScriptDir)
				If Not FileExists($MainAppx86) Then
					MsgBox(64, $gapTitle, "The main application (x86) path is invalid.")
					Exit
				Else
					$MainApp = $MainAppx86
				EndIf
			EndIf
		EndIf
		If $MainAppTemp[0] = 2 And @OSArch = "x64" Then
			Local $MainAppx64 = _PathFull($MainAppTemp[2], @ScriptDir)
			If Not FileExists($MainAppx64) Then
				Local $MainAppx86 = _PathFull($MainAppTemp[1], @ScriptDir)
				If Not FileExists($MainAppx86) Then
					MsgBox(64, $gapTitle, "The main application (x86) path and (x64) path are invalid.")
					Exit
				Else
					$MainApp = $MainAppx86
				EndIf
			Else
				$MainApp = $MainAppx64
			EndIf
		EndIf
		If $MainAppTemp[0] = 2 And @OSArch = "x86" Then
			Local $MainAppx86 = _PathFull($MainAppTemp[1], @ScriptDir)
			If Not FileExists($MainAppx86) Then
				MsgBox(64, $gapTitle, "The main application (x86) path is invalid.")
				Exit
			Else
				$MainApp = $MainAppx86
			EndIf
		EndIf
		If $MainAppTemp[0] = 1 Then
			Local $MainAppx86 = _PathFull($MainAppTemp[1], @ScriptDir)
			If Not FileExists($MainAppx86) Then
				MsgBox(64, $gapTitle, "The main application (x86) path is invalid.")
				Exit
			Else
				$MainApp = $MainAppx86
			EndIf
		EndIf
	EndIf
	addvar("MAINPROGRAM", "APPEXE", $MainApp, "V")
	Local $MainAppPath = StringRegExp($MainApp, "(?i)(.*)\\", 1)
	addvar("MAINPROGRAM", "EXEPATH", $MainAppPath[0], "V")
EndFunc   ;==>MainAppIni
;
;===============================================================================================================
; Function:		CmdLineIni()
;===============================================================================================================
Func CmdLineIni()
	Global $MainAppCmdLine = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "commandline", ""))
	addvar("MAINPROGRAM", "COMMANDLINE", $MainAppCmdLine, "V")
EndFunc   ;==>CmdLineIni
;
;===============================================================================================================
; Function:		MainAppWorkDirIni()
;===============================================================================================================
Func MainAppWorkDirIni()
	Global $MainAppWorkDir = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "workdir", ""))
	If $MainAppWorkDir = "" Then
		Local $MainAppWorkDirTemp = StringRegExp($MainApp, "(?i)(.*)\\", 1)
		$MainAppWorkDir = $MainAppWorkDirTemp[0]
	Else
		$MainAppWorkDir = _PathFull($MainAppWorkDir, @ScriptDir)
		If Not FileExists($MainAppWorkDir) Then
			MsgBox(64, $gapTitle, "The main application working directory path is invalid.")
			Exit
		EndIf
	EndIf
	addvar("MAINPROGRAM", "WORKDIR", $MainAppWorkDir, "V")
EndFunc   ;==>MainAppWorkDirIni
;
;===============================================================================================================
; Function:		MultipleInstIni()
;===============================================================================================================
Func MultipleInstIni()
	Local $multiple = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "!multiple", "0"))
	Local $gapUniqueCode = "@" & HashData(@ScriptFullPath) & "@" & $gapFileHash & "@"
	Local $multipleCheck = _SingletonPID($gapUniqueCode, 1)
	If $multipleCheck > 0 Then
		$gaPFirstInstance = 0
		If $multiple = -1 Then Exit
		If $multiple = 0 Then
			Local $multipleMessage = MsgBox(33, $gapTitle, Chr(34) & $gapExeName & ".exe" & Chr(34) & " is already running. Are you sure to launch another instance of the main application?")
			If $multipleMessage = 1 Then
				If $IsReadOnly = 0 Then
					IniWrite(@ScriptDir & "\@#$gapnew@#$", "NEWCMDLINE", "NewCmdLine", $CmdLineRaw)
				EndIf
				If $IsReadOnly = 1 Then
					DirCreate($CommonAppData & $gapExeName & "_" & $multipleCheck & "_" & $gapFileHash)
					IniWrite($CommonAppData & $gapExeName & "_" & $multipleCheck & "_" & $gapFileHash & "\@#$gapnew@#$", "NEWCMDLINE", "NewCmdLine", $CmdLineRaw)
				EndIf
				Exit
			EndIf
			If $multipleMessage = 2 Then Exit
		EndIf
		If $multiple = 1 Then
			If $IsReadOnly = 0 Then
				IniWrite(@ScriptDir & "\@#$gapnew@#$", "NEWCMDLINE", "NewCmdLine", $CmdLineRaw)
			EndIf
			If $IsReadOnly = 1 Then
				DirCreate($CommonAppData & $gapExeName & "_" & $multipleCheck & "_" & $gapFileHash)
				IniWrite($CommonAppData & $gapExeName & "_" & $multipleCheck & "_" & $gapFileHash & "\@#$gapnew@#$", "NEWCMDLINE", "NewCmdLine", $CmdLineRaw)
			EndIf
			Exit
		EndIf
	EndIf
EndFunc   ;==>MultipleInstIni
;
;===============================================================================================================
; Function:		IsAdminIni()
;===============================================================================================================
Func IsAdminIni()
	Local $IsAdmin = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "!admin", ""))
	If Not $IsAdmin = "" Then
		Select
			Case IsAdmin() = 0 And $IsAdmin = -1
				Exit

			Case IsAdmin() = 0 And $IsAdmin = 1
				Local $osVer = RegRead("HKLM\Software\Microsoft\Windows NT\CurrentVersion", "CurrentVersion")
				If $osVer >= 6.0 Then
					Local $UACState = RegRead("HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System", "EnableLUA")
					If $UACState = 0 Or $UACState = "" Then
						MsgBox(64, $gapTitle, Chr(34) & $gapExeName & ".exe" & Chr(34) & " could not be launched with administrator privileges. The main cause is explained below." & _
						" Please, check it and try again." & @CRLF & @CRLF & "System administrator disabled UAC (User Account Control) for all users. When this is done UAC dialogs" & _
						" will not be triggered and standard users will not be able to launch " & Chr(34) & $gapExeName & ".exe" & Chr(34) & " with administrator privileges.")
						Exit
					EndIf
				EndIf
				If ShellExecute(@ScriptFullPath, $CmdLineRaw, @ScriptDir, "runas") Then
					Exit
				Else
					MsgBox(64, $gapTitle, Chr(34) & $gapExeName & ".exe" & Chr(34) & " could not be launched with administrator privileges. Some possible causes are listed below." & _
					" Please, check them and try again." & @CRLF & @CRLF & "- User cancelled the ""Run As"" dialog;" & @CRLF & "- User cancelled the UAC (User Account Control)" & _
					" dialog;" & @CRLF & "- User filled the ""User name"" or ""Password"" fields with wrong data; and" & @CRLF & "- System administrator disabled UAC for all" & _
					" users. When this is done UAC dialogs will not be triggered and standard users will not be able to launch " & Chr(34) & $gapExeName & ".exe" & Chr(34) & " with" & _
					" administrator privileges.")
					Exit
				EndIf

			Case IsAdmin() = 0 And $IsAdmin = 2
				MsgBox(64, $gapTitle, "The main application requires administrator privileges to run.")
				Exit
		EndSelect
	EndIf
EndFunc   ;==>IsAdminIni
;
;===============================================================================================================
; Function:		DotNetIni()
;===============================================================================================================
Func DotNetIni()
	Local $DotNet = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "!dotnet", ""))
	If Not $DotNet = "" Then
		Local $DotNetVersions = "EMPTY"
		For $i = 1 To 100
			Local $DotNetKey = RegEnumKey("HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\NET Framework Setup\NDP", $i)
			If @error Then ExitLoop
			Local $DotNetKeyOV = StringRegExp($DotNetKey, "(?i)v\d\.\d", 1)
			If  $DotNetKeyOV <> 0 Then
				Local $DotNetKeyON = StringReplace($DotNetKeyOV[0], "v", "")
				$DotNetVersions = $DotNetVersions & "," & $DotNetKeyON
			EndIf
		Next
		Local $DotNetKey45up = RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full", "Release")
		If $DotNetKey45up = 378389 Then $DotNetKey45up = "4.5"
		If $DotNetKey45up = 378675 Then $DotNetKey45up = "4.5.1"
		If $DotNetKey45up = 378758 Then $DotNetKey45up = "4.5.1"
		If $DotNetKey45up = 379893 Then $DotNetKey45up = "4.5.2"
		If $DotNetKey45up = 381029 Then $DotNetKey45up = "4.6"
		If $DotNetKey45up <> 0 Then $DotNetVersions = $DotNetVersions & "," & $DotNetKey45up
		Local $DotNetExit = StringInStr($DotNet, "!", 0)
		$DotNet = StringReplace($DotNet, "!", "", 0)
		Local $DotNetCheck = StringInStr($DotNetVersions, $DotNet, 0)
		If $DotNetCheck = 0 And $DotNetExit = 0 Then MsgBox(64, $gapTitle, "The main application requires .NET Framework version " & $DotNet & " to run.")
		If $DotNetCheck = 0 And $DotNetExit > 0 Then
			MsgBox(64, $gapTitle, "The main application requires .NET Framework version " & $DotNet & " to run.")
			Exit
		EndIf
	EndIf
EndFunc   ;==>DotNetIni
;
;===============================================================================================================
; Function:		OnlineIni()
;===============================================================================================================
Func OnlineIni()
	Local $online = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "!online", ""))
	If Not $online = "" Then
		Local $onlineAddress1 = Ping("127.0.0.1", 4000)
		Local $onlineAddress2 = Ping("www.google.com", 4000)
		Local $onlineAddress3 = Ping("www.microsoft.com", 4000)
		Local $onlineNtry = 5
		Local $onlineStatus1 = 0
		Local $onlineStatus2 = 0
		Local $onlineStatus3 = 0
		Local $onlineCheck = 0
		For $onlinei = 1 To $onlineNtry
			If $onlineAddress1 Then $onlineStatus1 = 1
			If $onlineAddress2 Then	$onlineStatus2 = 1
			If $onlineAddress3 Then	$onlineStatus3 = 1
			Select
				Case $onlineStatus1 = 1 And $onlineStatus2 = 1
					$onlineCheck = 1
					ExitLoop

				Case $onlineStatus1 = 1 And $onlineStatus3 = 1
					$onlineCheck = 1
					ExitLoop

			EndSelect
		Next
		Select
			Case $onlineCheck = 0 And $online = 1
				Local $onlineMessage = MsgBox(33, $gapTitle, "The main application requires an active Internet connection to run. Continue anyway?")
				If $onlineMessage = 2 Then Exit

			Case $onlineCheck = 0 And $online = 2
				Local $onlineMessage = MsgBox(64, $gapTitle, "The main application requires an active Internet connection to run.")
				Exit

			Case $onlineCheck = 0 And $online = -1
				Exit

			Case $onlineCheck = 1 And $online = -2
				Local $onlineMessage = MsgBox(33, $gapTitle, "The main application requires an inactive Internet connection to run. Continue anyway?")
				If $onlineMessage = 2 Then Exit

			Case $onlineCheck = 1 And $online = -3
				Local $onlineMessage = MsgBox(64, $gapTitle, "The main application requires an inactive Internet connection to run.")
				Exit

			Case $onlineCheck = 1 And $online = -4
				Exit

		EndSelect
	EndIf
EndFunc   ;==>OnlineIni
;
;===============================================================================================================
; Function:		OSIni()
;===============================================================================================================
Func OSIni()
	Local $os = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "!os", ""))
	If Not $os = "" Then
		Local $osVer = RegRead("HKLM\Software\Microsoft\Windows NT\CurrentVersion", "CurrentVersion")
		Select
			Case $os = "XP"
				If Not $osVer >= 5.1 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows XP or newer.")
					Exit
				EndIf

			Case $os = "Vista"
				If Not $osVer >= 6.0 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows Vista or newer.")
					Exit
				EndIf

			Case $os = "7"
				If Not $osVer >= 6.1 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows 7 or newer.")
					Exit
				EndIf

			Case $os = "8"
				If Not $osVer >= 6.2 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows 8 or newer.")
					Exit
				EndIf

			Case $os = "8.1"
				If Not $osVer >= 6.3 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows 8.1 or newer.")
					Exit
				EndIf

			Case $os = "<XP"
				If Not $osVer <= 5.1 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows XP or older.")
					Exit
				EndIf

			Case $os = "<Vista"
				If Not $osVer <= 6.0 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows Vista or older.")
					Exit
				EndIf

			Case $os = "<7"
				If Not $osVer <= 6.1 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows 7 or older.")
					Exit
				EndIf

			Case $os = "<8"
				If Not $osVer <= 6.2 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows 8 or older.")
					Exit
				EndIf

			Case $os = "<8.1"
				If Not $osVer <= 6.3 Then
					MsgBox(64, $gapTitle, "The main application requires a host Operating System equal Windows 8.1 or older.")
					Exit
				EndIf

		EndSelect
	EndIf
EndFunc   ;==>OSIni
;
;===============================================================================================================
; Function:		WaitIni()
;===============================================================================================================
Func WaitIni()
	Global $waitprocess = FindReplaceX("MAINPROGRAM", IniRead($gapIniFilePath, "GENERAL", "!waitprocess", ""))
EndFunc   ;==>WaitIni
;
;===============================================================================================================
; Function:		RunMainAppProc()
;===============================================================================================================
Func RunMainAppProc()
	Local $MainAppRun = Run($MainApp & " " & $MainAppCmdLine & " " & $CmdLineRaw, $MainAppWorkDir, $MainAppShowState)
	If $gapWait = 1 Then
		Local $gapPID = @AutoItPID
		Local $gapChildren = _WinAPI_EnumChildProcess($gaPPID)
		While $gapChildren <> 0
			Sleep(250)
			If FileExists(@ScriptDir & "\@#$gapnew@#$") Then
				$CmdLineRaw = IniRead(@ScriptDir & "\@#$gapnew@#$", "NEWCMDLINE", "NewCmdLine", "")
				FileDelete(@ScriptDir & "\@#$gapnew@#$")
				$MainAppRun = Run($MainApp & " " & $MainAppCmdLine & " " & $CmdLineRaw, $MainAppWorkDir, $MainAppShowState)
			EndIf
			If FileExists($CommonAppData & $gapExeName & "_" & @AutoItPID & "_" & $gapFileHash & "\@#$gapnew@#$") Then
				$CmdLineRaw = IniRead($CommonAppData & $gapExeName & "_" & @AutoItPID & "_" & $gapFileHash & "\@#$gapnew@#$", "NEWCMDLINE", "NewCmdLine", "")
				DirRemove($CommonAppData & $gapExeName & "_" & @AutoItPID & "_" & $gapFileHash, 1)
				$MainAppRun = Run($MainApp & " " & $MainAppCmdLine & " " & $CmdLineRaw, $MainAppWorkDir, $MainAppShowState)
			EndIf
			$gapChildren = _WinAPI_EnumChildProcess($gaPPID)
		WEnd
		If $waitprocess <> "" Then WinWaitClose($waitprocess)
	EndIf
EndFunc   ;==>RunMainAppProc
;
;===============================================================================================================
; Function:		BeforeSecIni()
;===============================================================================================================
Func BeforeSecIni()
	If $RunBeforeSec = 1 Then
		Global $BeforeSecArray = IniReadSection($gapIniFilePath, "BEFORE")
		If $BeforeSecArray = 1 Then
			$BeforeSecArray = StringSplit("DONE!", ",", 1)
			_ArrayColInsert($BeforeSecArray, 1)
			_ArrayColInsert($BeforeSecArray, 2)
			$BeforeSecArray[1][1] = "DONE!"
		Else
			_ArrayColInsert($BeforeSecArray, 2)
		EndIf
		If $DebugLog = 1 Then
			DebugLogWrite("MAINPROGRAM", "[Before Section Tasks List - Raw]", 0, 0)
			DebugLogWrite("MAINPROGRAM", $BeforeSecArray, 1, 1)
		EndIf
		For $bai = 1 To $BeforeSecArray[0][0]
			$BeforeSecArray[$bai][2]= "USER"
		Next
		For $bai = 1 To $BeforeSecArray[0][0]
			If $BeforeSecArray[$bai][0] <> "DONE!" Then
				If $BeforeSecArray[$bai][1] = "" Then
					$BeforeSecArray[$bai][1] = "BEFORE"
				Else
					$BeforeSecArray[$bai][1] = "BEFORE :: " & $BeforeSecArray[$bai][1]
				EndIf
			EndIf
		Next
		For $bai = 1 To $BeforeSecArray[0][0]
			Local $BSAx86Check = StringInStr($BeforeSecArray[$bai][0], "x86", 0, 1)
			Local $BSAx64Check = StringInStr($BeforeSecArray[$bai][0], "x64", 0, 1)
			Select
				Case @OSArch = "x86" And $BSAx86Check > 0 And $BSAx64Check = 0
					$BeforeSecArray[$bai][0] = Stringreplace($BeforeSecArray[$bai][0], "x86", "", 0, 0)

				Case @OSArch = "x86" And $BSAx86Check = 0 And $BSAx64Check > 0
					$BeforeSecArray[$bai][0] = "DONE!"
					$BeforeSecArray[$bai][1] = "DONE!"

				Case @OSArch = "x86" And $BSAx86Check > 0 And $BSAx64Check > 0
					$BeforeSecArray[$bai][0] = "DONE!"
					$BeforeSecArray[$bai][1] = "DONE!"

				Case @OSArch = "x64" And $BSAx86Check = 0 And $BSAx64Check > 0
					$BeforeSecArray[$bai][0] = Stringreplace($BeforeSecArray[$bai][0], "x64", "", 0, 0)

				Case @OSArch = "x64" And $BSAx86Check > 0 And $BSAx64Check = 0
					$BeforeSecArray[$bai][0] = "DONE!"
					$BeforeSecArray[$bai][1] = "DONE!"

				Case @OSArch = "x64" And $BSAx86Check > 0 And $BSAx64Check > 0
					$BeforeSecArray[$bai][0] = "DONE!"
					$BeforeSecArray[$bai][1] = "DONE!"

			EndSelect
		Next
		For $bai = 1 To $BeforeSecArray[0][0]
			Local $BSpecialChrArray = StringSplit("(,p,),p,->,LTR,<-,RTL,-,minus,+,plus,stringreplace,gstringreplace,run,grun,iniread,giniread,iniwrite,giniwrite", ",", 1)
			For $BSCai = 1 To $BSpecialChrArray[0] Step 2
				$BeforeSecArray[$bai][0] = StringReplace($BeforeSecArray[$bai][0], $BSpecialChrArray[$BSCai], $BSpecialChrArray[$BSCai + 1], 0, 1)
			Next
		Next
		If $DebugLog = 1 Then
			DebugLogWrite("MAINPROGRAM", "[Before Section Tasks List - Initialized]", 0, 0)
			DebugLogWrite("MAINPROGRAM", $BeforeSecArray, 1, 1)
		EndIf
	EndIf
EndFunc   ;==>BeforeSecIni
;
;===============================================================================================================
; Function:		AfterSecIni()
;===============================================================================================================
Func AfterSecIni()
	If $RunAfterSec = 1 Then
		Global $AfterSecArray = IniReadSection($gapIniFilePath, "AFTER")
		If $AfterSecArray = 1 Then
			$AfterSecArray = StringSplit("DONE!", ",", 1)
			_ArrayColInsert($AfterSecArray, 1)
			_ArrayColInsert($AfterSecArray, 2)
			$AfterSecArray[1][1] = "DONE!"
		Else
			_ArrayColInsert($AfterSecArray, 2)
		EndIf
		If $DebugLog = 1 Then
			DebugLogWrite("MAINPROGRAM", "[After Section Tasks List - Raw]", 0, 0)
			DebugLogWrite("MAINPROGRAM", $AfterSecArray, 1, 1)
		EndIf
		For $aai = 1 To $AfterSecArray[0][0]
			$AfterSecArray[$aai][2] = "USER"
		Next
		For $aai = 1 To $AfterSecArray[0][0]
			If $AfterSecArray[$aai][0] <> "DONE!" Then
				If $AfterSecArray[$aai][1] = "" Then
					$AfterSecArray[$aai][1] = "AFTER"
				Else
					$AfterSecArray[$aai][1] = "AFTER :: " & $AfterSecArray[$aai][1]
				EndIf
			EndIf
		Next
		For $aai = 1 To $AfterSecArray[0][0]
			Local $ASAx86Check = StringInStr($AfterSecArray[$aai][0], "x86", 0, 1)
			Local $ASAx64Check = StringInStr($AfterSecArray[$aai][0], "x64", 0, 1)
			Select
				Case @OSArch = "x86" And $ASAx86Check > 0 And $ASAx64Check = 0
					$AfterSecArray[$aai][0] = Stringreplace($AfterSecArray[$aai][0], "x86", "", 0, 0)

				Case @OSArch = "x86" And $ASAx86Check = 0 And $ASAx64Check > 0
					$AfterSecArray[$aai][0] = "DONE!"
					$AfterSecArray[$aai][1] = "DONE!"

				Case @OSArch = "x86" And $ASAx86Check > 0 And $ASAx64Check > 0
					$AfterSecArray[$aai][0] = "DONE!"
					$AfterSecArray[$aai][1] = "DONE!"

				Case @OSArch = "x64" And $ASAx86Check = 0 And $ASAx64Check > 0
					$AfterSecArray[$aai][0] = Stringreplace($AfterSecArray[$aai][0], "x64", "", 0, 0)

				Case @OSArch = "x64" And $ASAx86Check > 0 And $ASAx64Check = 0
					$AfterSecArray[$aai][0] = "DONE!"
					$AfterSecArray[$aai][1] = "DONE!"

				Case @OSArch = "x64" And $ASAx86Check > 0 And $ASAx64Check > 0
					$AfterSecArray[$aai][0] = "DONE!"
					$AfterSecArray[$aai][1] = "DONE!"

			EndSelect
		Next
		For $aai = 1 To $AfterSecArray[0][0]
			Local $ASpecialChrArray = StringSplit("(,p,),p,->,LTR,<-,RTL,-,minus,+,plus,stringreplace,gstringreplace,run,grun,iniread,giniread,iniwrite,giniwrite", ",", 1)
			For $ASCai = 1 To $ASpecialChrArray[0] Step 2
				$AfterSecArray[$aai][0] = StringReplace($AfterSecArray[$aai][0], $ASpecialChrArray[$ASCai], $ASpecialChrArray[$ASCai + 1], 0, 1)
			Next
		Next
		If $DebugLog = 1 Then
			DebugLogWrite("MAINPROGRAM", "[After Section Tasks List - Initialized]", 0, 0)
			DebugLogWrite("MAINPROGRAM", $AfterSecArray, 1, 1)
		EndIf
	EndIf
EndFunc   ;==>AfterSecIni
;
;===============================================================================================================
; Function:		BeforeSecProc()
;===============================================================================================================
Func BeforeSecProc()
	If $RunBeforeSec = 1 Then
		For $bai = 1 To $BeforeSecArray[0][0]
			Local $BRunFirst = "uservar,envvar,giniread,gstringreplace"
			Local $BRFArray = StringSplit($BRunFirst, ",", 1)
			For $brfai = 1 To $BRFArray[0]
				If $BeforeSecArray[$bai][0] = $BRFArray[$brfai] Then
					Local $ParamBArray = StringSplit($BeforeSecArray[$bai][1], " :: ", 1)
					Local $CallArgBArray[$ParamBArray[0] + 1]
					$CallArgBArray[0] = "CallArgArray"
					For $pbai = 1 To $ParamBArray[0]
						$CallArgBArray[$pbai] = $ParamBArray[$pbai]
					Next
					Call($BeforeSecArray[$bai][0], $CallArgBArray)
					$BeforeSecArray[$bai][0] = "DONE!"
					$BeforeSecArray[$bai][1] = "DONE!"
				EndIf
			Next
		Next
		For $bai = 1 To $BeforeSecArray[0][0]
			If $BeforeSecArray[$bai][0] <> "DONE!" Then
				Local $ParamBArray = StringSplit($BeforeSecArray[$bai][1], " :: ", 1)
				Local $CallArgBArray[$ParamBArray[0] + 1]
				$CallArgBArray[0] = "CallArgArray"
				For $pbai = 1 To $ParamBArray[0]
					$CallArgBArray[$pbai] = $ParamBArray[$pbai]
				Next
				Call($BeforeSecArray[$bai][0], $CallArgBArray)
				$BeforeSecArray[$bai][0] = "DONE!"
				$BeforeSecArray[$bai][1] = "DONE!"
			EndIf
		Next
		If $DebugLog = 1 Then
			DebugLogWrite("MAINPROGRAM", "[Before Section Tasks List - Processed]", 0, 0)
			DebugLogWrite("MAINPROGRAM", $BeforeSecArray, 1, 1)
			DebugLogWrite("MAINPROGRAM", "[Variables List]", 0, 0)
			DebugLogWrite("MAINPROGRAM", $VarArray, 1, 1)
			DebugLogWrite("MAINPROGRAM", "[After Section Tasks List - Reinitialized]", 0, 0)
			DebugLogWrite("MAINPROGRAM", $AfterSecArray, 1, 1)
		EndIf
	EndIf
EndFunc   ;==>BeforeSecProc
;
;===============================================================================================================
; Function:		AfterSecProc()
;===============================================================================================================
Func AfterSecProc()
	If $RunAfterSec = 1 Then
		For $aai = 1 To $AfterSecArray[0][0]
			Local $ARunFirst = "nowait,quit,uservar,envvar,giniread,gstringreplace"
			Local $ARFArray = StringSplit($ARunFirst, ",", 1)
			For $arfai = 1 To $ARFArray[0]
				If $AfterSecArray[$aai][0] = $ARFArray[$arfai] Then
					Local $ParamAArray = StringSplit($AfterSecArray[$aai][1], " :: ", 1)
					Local $CallArgAArray[$ParamAArray[0] + 1]
					$CallArgAArray[0] = "CallArgArray"
					For $paai = 1 To $ParamAArray[0]
						$CallArgAArray[$paai] = $ParamAArray[$paai]
					Next
					Call($AfterSecArray[$aai][0], $CallArgAArray)
					$AfterSecArray[$aai][0] = "DONE!"
					$AfterSecArray[$aai][1] = "DONE!"
				EndIf
			Next
		Next
		For $aai = 1 To $AfterSecArray[0][0]
			If $AfterSecArray[$aai][0] <> "DONE!" Then
				Local $ParamAArray = StringSplit($AfterSecArray[$aai][1], " :: ", 1)
				Local $CallArgAArray[$ParamAArray[0] + 1]
				$CallArgAArray[0] = "CallArgArray"
				For $paai = 1 To $ParamAArray[0]
					$CallArgAArray[$paai] = $ParamAArray[$paai]
				Next
				Call($AfterSecArray[$aai][0], $CallArgAArray)
				$AfterSecArray[$aai][0] = "DONE!"
				$AfterSecArray[$aai][1] = "DONE!"
			EndIf
		Next
		If $DebugLog = 1 Then
			DebugLogWrite("MAINPROGRAM", "[After Section Tasks List - Processed]", 0, 0)
			DebugLogWrite("MAINPROGRAM", $AfterSecArray, 1, 1)
			DebugLogWrite("MAINPROGRAM", "[Variables List]", 0, 0)
			DebugLogWrite("MAINPROGRAM", $VarArray, 1, 0)
		EndIf
	EndIf
EndFunc   ;==>AfterSecProc
;
;===============================================================================================================
; Function:		CleanMUICache()
;===============================================================================================================
Func CleanMUICache($CMUIFFilePath = "NULL")
	If $CMUIFFilePath = "NULL" Then
		$CMUIFFilePath = @ScriptFullPath
	Else
		$CMUIFFilePath = _PathFull(FindReplaceX("MAINPROGRAM", $CMUIFFilePath), @ScriptDir)
	EndIf
	Local $CMUIFosVer = RegRead("HKLM\Software\Microsoft\Windows NT\CurrentVersion", "CurrentVersion")
	If $CMUIFosVer >= 6.0 Then
		Local $CMUIFEntry1 = RegRead("HKEY_CURRENT_USER\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache", $CMUIFFilePath)
		If @error = 0 Then RegDelete("HKEY_CURRENT_USER\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache", $CMUIFFilePath)
		If IsDeclared("MainApp") And $CMUIFFilePath = @ScriptFullPath Then
			Local $CMUIFEntry2 = RegRead("HKEY_CURRENT_USER\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache", $MainApp)
			If @error = 0 Then RegDelete("HKEY_CURRENT_USER\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache", $MainApp)
		EndIf
	Else
		Local $CMUIFEntry1 = RegRead("HKEY_CURRENT_USER\Software\Microsoft\Windows\ShellNoRoam\MUICache", $CMUIFFilePath)
		If @error = 0 Then RegDelete("HKEY_CURRENT_USER\Software\Microsoft\Windows\ShellNoRoam\MUICache", $CMUIFFilePath)
		If IsDeclared("MainApp") And $CMUIFFilePath = @ScriptFullPath Then
			Local $CMUIFEntry2 = RegRead("HKEY_CURRENT_USER\Software\Microsoft\Windows\ShellNoRoam\MUICache", $MainApp)
			If @error = 0 Then RegDelete("HKEY_CURRENT_USER\Software\Microsoft\Windows\ShellNoRoam\MUICache", $MainApp)
		EndIf
	EndIf
EndFunc   ;==>CleanMUICache
;
;===============================================================================================================
; Function:		CleanAppPaths()
;===============================================================================================================
Func CleanAppPaths($CAPFFilePath = "NULL")
	If $CAPFFilePath = "NULL" Then
		$CAPFFilePath = @ScriptFullPath
	Else
		$CAPFFilePath = _PathFull(FindReplaceX("MAINPROGRAM", $CAPFFilePath), @ScriptDir)
	EndIf
	Local $CAPFgapExeName = StringRegExp($CAPFFilePath, "(?i).*\\(.*\..*)", 1)
	$CAPFgapExeName = $CAPFgapExeName[0]
	Local $CAPFEntry1 = RegRead("HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\App Paths\" & $CAPFgapExeName, "")
	If @error = 0 Then
		Local $CAPFEntry1Check = StringInStr($CAPFEntry1, $CAPFFilePath, 0, 1)
		If $CAPFEntry1Check > 0 Then RegDelete("HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\App Paths\" & $CAPFgapExeName)
	EndIf
	Local $CAPFEntry2 = RegRead("HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\" & $CAPFgapExeName, "")
	If @error = 0 Then
		Local $CAPFEntry2Check = StringInStr($CAPFEntry2, $CAPFFilePath, 0, 1)
		If $CAPFEntry2Check > 0 Then RegDelete("HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\" & $CAPFgapExeName)
	EndIf
	If IsDeclared("MainApp") And $CAPFFilePath = @ScriptFullPath Then
		Local $CAPFMainAppExeName = StringRegExp($MainApp, "(?i).*\\(.*\..*)", 1)
		$CAPFMainAppExeName = $CAPFMainAppExeName[0]
		Local $CAPFEntry3 = RegRead("HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\App Paths\" & $CAPFMainAppExeName, "")
		If @error = 0 Then
			Local $CAPFEntry3Check = StringInStr($CAPFEntry3, $MainApp, 0, 1)
			If $CAPFEntry3Check > 0 Then RegDelete("HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\App Paths\" & $CAPFMainAppExeName)
		EndIf
		Local $CAPFEntry4 = RegRead("HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\" & $CAPFMainAppExeName, "")
		If @error = 0 Then
			Local $CAPFEntry4Check = StringInStr($CAPFEntry4, $MainApp, 0, 1)
			If $CAPFEntry4Check > 0 Then RegDelete("HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\" & $CAPFMainAppExeName)
		EndIf
	EndIf
EndFunc   ;==>CleanAppPaths
;
;===============================================================================================================
; Function:		clean() - clean
;===============================================================================================================
Func clean($cleanFCaller, $cleanFFilePath)
	If $cleanFCaller = "BEFORE" Or $cleanFCaller = "AFTER" Then
		CleanMUICache($cleanFFilePath)
		CleanAppPaths($cleanFFilePath)
	Else
		Local $cleanFError = MsgBox(64, $gapTitle, "The ""clean"" function can't be called from the """ & $cleanFCaller & """ section.")
	EndIf
EndFunc   ;==>clean
;
;===============================================================================================================
; Function:		dir() - dir
;===============================================================================================================
Func dir($dirFCaller, $dirFSource, $dirFTarget = "NULL")
	If $dirFCaller = "BEFORE" Then
		$dirFSource = _PathFull(FindReplaceX("MAINPROGRAM", $dirFSource), @ScriptDir)
		LTRdir($dirFCaller, $dirFSource, $dirFSource & "_backup", "move, overwrite")
		LTRdir($dirFCaller, $dirFTarget, $dirFSource, "copy, overwrite")
		Local $dirFArray[2]
		_ArrayColInsert($dirFArray, 1)
		_ArrayColInsert($dirFArray, 2)
		$dirFArray[0][0] = "LTRdir"
		$dirFArray[0][1] = "BEFORE :: " & $dirFSource & " :: " & $dirFTarget & " :: move, overwrite"
		$dirFArray[0][2] = "PROG"
		$dirFArray[1][0] = "RTLdir"
		$dirFArray[1][1] = "BEFORE :: " & $dirFSource & " :: " & $dirFSource & "_backup" & " :: move, overwrite"
		$dirFArray[1][2] = "PROG"
		For $dirFArrayi = 0 To UBound($dirFArray) - 1
			_ArrayInsert($AfterSecArray, _ArraySearch($AfterSecArray, "USER", 0, 0, 0, 0, 1, 2), _ArrayExtract($dirFArray, $dirFArrayi, $dirFArrayi))
		Next
		$AfterSecArray[0][0] = $AfterSecArray[0][0] + 2
	Else
		Local $dirFError = MsgBox(64, $gapTitle, "The ""dir"" function can't be called from the """ & $dirFCaller & """ section.")
	EndIf
EndFunc   ;==>dir
;
;===============================================================================================================
; Function:		file() - file
;===============================================================================================================
Func file($fileFCaller, $fileFSource, $fileFTarget = "NULL")
	If $fileFCaller = "BEFORE" Then
		LTRfile($fileFCaller, $fileFSource, $fileFSource & "_backup", "move, overwrite")
		LTRfile($fileFCaller, $fileFTarget, $fileFSource, "copy, overwrite")
		Local $fileFArray[2]
		_ArrayColInsert($fileFArray, 1)
		_ArrayColInsert($fileFArray, 2)
		$fileFArray[0][0] = "LTRfile"
		$fileFArray[0][1] = "BEFORE :: " & $fileFSource & " :: " & $fileFTarget & " :: move, overwrite"
		$fileFArray[0][2] = "PROG"
		$fileFArray[1][0] = "RTLfile"
		$fileFArray[1][1] = "BEFORE :: " & $fileFSource & " :: " & $fileFSource & "_backup" & " :: move, overwrite"
		$fileFArray[1][2] = "PROG"
		For $fileFArrayi = 0 To UBound($fileFArray) - 1
			_ArrayInsert($AfterSecArray, _ArraySearch($AfterSecArray, "USER", 0, 0, 0, 0, 1, 2), _ArrayExtract($fileFArray, $fileFArrayi, $fileFArrayi))
		Next
		$AfterSecArray[0][0] = $AfterSecArray[0][0] + 2
	Else
		Local $fileFError = MsgBox(64, $gapTitle, "The ""file"" function can't be called from the """ & $fileFCaller & """ section.")
	EndIf
EndFunc   ;==>file
;
;===============================================================================================================
; Function:		regkey() - regkey
;===============================================================================================================
Func regkey($regkFCaller, $regkFSource, $regkFTarget = "NULL", $regkFFlag = "NULL")
	If $regkFCaller = "BEFORE" Then
		$regkFSource = FindReplaceX("MAINPROGRAM", $regkFSource)
		Local $regkFCheck1 = StringRight($regkFSource, 1)
		If $regkFCheck1 = "\" Then $regkFSource = StringReplace($regkFSource, "\", "", -1, 1)
		LTRregkey($regkFCaller, $regkFSource, $regkFSource & "_backup", "copy", $regkFFlag)
		minusregkey($regkFCaller, $regkFSource, "NULL", $regkFFlag)
		regimport($regkFCaller, $regkFTarget, $regkFFlag)
		Local $regkFArray[4]
		_ArrayColInsert($regkFArray, 1)
		_ArrayColInsert($regkFArray, 2)
		$regkFArray[0][0] = "regexport"
		$regkFArray[0][1] = "BEFORE :: " & $regkFSource & "\ :: " & $regkFTarget & " :: " & $regkFFlag
		$regkFArray[0][2] = "PROG"
		$regkFArray[1][0] = "minusregkey"
		$regkFArray[1][1] = "BEFORE :: " & $regkFSource & " :: NULL :: " & $regkFFlag
		$regkFArray[1][2] = "PROG"
		$regkFArray[2][0] = "RTLregkey"
		$regkFArray[2][1] = "BEFORE :: " & $regkFSource & " :: " & $regkFSource & "_backup" & " :: move :: " & $regkFFlag
		$regkFArray[2][2] = "PROG"
		$regkFArray[3][0] = "minusregkey"
		$regkFArray[3][1] = "BEFORE :: " & $regkFSource & " :: ifempty :: " & $regkFFlag
		$regkFArray[3][2] = "PROG"
		For $regkFArrayi = 0 To UBound($regkFArray) - 1
			_ArrayInsert($AfterSecArray, _ArraySearch($AfterSecArray, "USER", 0, 0, 0, 0, 1, 2), _ArrayExtract($regkFArray, $regkFArrayi, $regkFArrayi))
		Next
		$AfterSecArray[0][0] = $AfterSecArray[0][0] + 4
	Else
		Local $regkFError = MsgBox(64, $gapTitle, "The ""regkey"" function can't be called from the """ & $regkFCaller & """ section.")
	EndIf
EndFunc   ;==>regkey
;
;===============================================================================================================
; Function:		regvalue() - regvalue
;===============================================================================================================
Func regvalue($regvFCaller, $regvFSource, $regvFTarget = "NULL", $regvFFlag = "NULL")
	If $regvFCaller = "BEFORE" Then
		$regvFSource = FindReplaceX("MAINPROGRAM", $regvFSource)
		Local $regvFCheck1 = StringRight($regvFSource, 1)
		If $regvFCheck1 = "\" Then $regvFSource = StringReplace($regvFSource, "\", "", -1, 1)
		Local $regvFCheck2 = StringSplit($regvFSource, "\", 1)
		Local $regvFSourceK = StringReplace($regvFSource, "\" & $regvFCheck2[$regvFCheck2[0]], "", -1, 1)
		Local $regvFSourceV = $regvFCheck2[$regvFCheck2[0]]
		LTRregvalue($regvFCaller, $regvFSource, $regvFSource & "_backup", "copy", $regvFFlag)
		regimport($regvFCaller, $regvFTarget, $regvFFlag)
		Local $regvFArray[4]
		_ArrayColInsert($regvFArray, 1)
		_ArrayColInsert($regvFArray, 2)
		$regvFArray[0][0] = "regexport"
		$regvFArray[0][1] = "BEFORE :: " & $regvFSource & " :: " & $regvFTarget & " :: " & $regvFFlag
		$regvFArray[0][2] = "PROG"
		$regvFArray[1][0] = "minusregvalue"
		$regvFArray[1][1] = "BEFORE :: " & $regvFSourceK & " :: " & $regvFSourceV & " :: " & $regvFFlag
		$regvFArray[1][2] = "PROG"
		$regvFArray[2][0] = "RTLregvalue"
		$regvFArray[2][1] = "BEFORE :: " & $regvFSource & " :: " & $regvFSource & "_backup" & " :: move :: " & $regvFFlag
		$regvFArray[2][2] = "PROG"
		$regvFArray[3][0] = "minusregkey"
		$regvFArray[3][1] = "BEFORE :: " & $regvFSourceK & " :: ifempty :: " & $regvFFlag
		$regvFArray[3][2] = "PROG"
		For $regvFArrayi = 0 To UBound($regvFArray) - 1
			_ArrayInsert($AfterSecArray, _ArraySearch($AfterSecArray, "USER", 0, 0, 0, 0, 1, 2), _ArrayExtract($regvFArray, $regvFArrayi, $regvFArrayi))
		Next
		$AfterSecArray[0][0] = $AfterSecArray[0][0] + 4
	Else
		Local $regvFError = MsgBox(64, $gapTitle, "The ""regvalue"" function can't be called from the """ & $regvFCaller & """ section.")
	EndIf
EndFunc   ;==>regvalue
