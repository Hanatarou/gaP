		Local $pdirpFArray[1]
		_ArrayColInsert($pdirpFArray, 1)
		_ArrayColInsert($pdirpFArray, 2)
		$pdirpFArray[0][0] = "RTLdir"
		$pdirpFArray[0][1] = "BEFORE :: " & $pdirpFSource & " :: " & $pdirpFSource & "_backup" & " :: move, overwrite"
		$pdirpFArray[0][2] = "PROG"
		For $pdirpFArrayi = 0 To UBound($pdirpFArray) - 1
			_ArrayInsert($AfterSecArray, _ArraySearch($AfterSecArray, "USER", 0, 0, 0, 0, 1, 2), _ArrayExtract($pdirpFArray, $pdirpFArrayi, $pdirpFArrayi))
		Next
		$AfterSecArray[0][0] = $AfterSecArray[0][0] + 1
	Else
		Local $pdirpFError = MsgBox(64, $gapTitle, "The ""(dir)"" function can't be called from the """ & $pdirpFCaller & """ section.")
	EndIf
EndFunc   ;==>pdirp
