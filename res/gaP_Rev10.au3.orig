;===============================================================================================================
; Function:		VarFuncIni()
;===============================================================================================================
Func VarFuncIni()
	Global $VarArray[2]
	_ArrayColInsert($VarArray, 0)
	$VarArray[0][0] = 1
	$VarArray[1][0] = "GAPROOT"
	$VarArray[1][1] = $gapExeDrive & StringReplace($gapExeDir, "\", "", -1, 1)
	Global $FuncArray[2]
	_ArrayColInsert($FuncArray, 0)
	$FuncArray[0][0] = 1
	$FuncArray[1][0] = "LANGCODE"
	$FuncArray[1][1] = "langcode"
	addvar("MAINPROGRAM", "DRIVE", StringReplace($gapExeDrive, ":", ""), "V")
	addvar("MAINPROGRAM", "LINEBREAK", @CRLF, "V")
	addvar("MAINPROGRAM", "PARAMETERS", $CmdLineRaw, "V")
	addvar("MAINPROGRAM", "OSARCH", StringLower(@OSArch), "V")
	addvar("MAINPROGRAM", "USERDIR", "userdir", "F")
	addvar("MAINPROGRAM", "USERFILE", "userfile", "F")
	addvar("MAINPROGRAM", "USERTEXT", "usertext", "F")
	addvar("MAINPROGRAM", "CLIPBOARD", "ClipGet", "F")
	addvar("MAINPROGRAM", "d", "day2", "F")
	addvar("MAINPROGRAM", "j", "day1", "F")
	addvar("MAINPROGRAM", "m", "mon2", "F")
	addvar("MAINPROGRAM", "n", "mon1", "F")
	addvar("MAINPROGRAM", "Y", "year4", "F")
	addvar("MAINPROGRAM", "y", "year2", "F")
	addvar("MAINPROGRAM", "H", "hour242", "F")
	addvar("MAINPROGRAM", "G", "hour241", "F")
	addvar("MAINPROGRAM", "h", "hour122", "F")
	addvar("MAINPROGRAM", "g", "hour121", "F")
	addvar("MAINPROGRAM", "i", "min2", "F")
	addvar("MAINPROGRAM", "s", "sec2", "F")
	addvar("MAINPROGRAM", "U", "sEPOCH", "F")
	addvar("MAINPROGRAM", "LANG", "lang", "F")
	addvar("MAINPROGRAM", "LOCALE", "locale", "F")
	addvar("MAINPROGRAM", "LOCALENAME", "localename", "F")
	addvar("MAINPROGRAM", "LOCALENAME_SHORT", "localenameshort", "F")
	addvar("MAINPROGRAM", "COUNTRY", "country", "F")
EndFunc   ;==>VarFuncIni
