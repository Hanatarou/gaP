		CleanAppPaths()
		_ReduceMemory(0)
		; Cleaning traces of gaP and main application - End
		; Initialization of the before section - Start
		BeforeSecIni()
		; Initialization of the before section - End
		_ReduceMemory(0)
		; Initialization of the after section - Start
		AfterSecIni()
		; Initialization of the after section - End
		; Closing the gap ini file - Start
