	"11265,ar-JO,Arabic - Jordan,11273,en-TT,English - Trinidad and Tobago,11274,es-AR,Spanish - Argentina,11290,sr-Latn-ME,Serbian (Latin) - Montenegro,12289,ar-LB,Arabic - Lebanon,12297,en-ZW,English - Zimbabwe," & _
	"12298,es-EC,Spanish - Ecuador,12314,sr-Cyrl-ME,Serbian (Cyrillic) - Montenegro,13313,ar-KW,Arabic - Kuwait,13321,en-PH,English - Philippines,13322,es-CL,Spanish - Chile,14337,ar-AE,Arabic - U.A.E.," & _
	"14346,es-UY,Spanish - Uruguay,15361,ar-BH,Arabic - Bahrain,15370,es-PY,Spanish - Paraguay,16385,ar-QA,Arabic - Qatar,16393,en-IN,English - India,16394,es-BO,Spanish - Bolivia,17417,en-MY,English - Malaysia," & _
	"17418,es-SV,Spanish - El Salvador,18441,en-SG,English - Singapore,18442,es-HN,Spanish - Honduras,19466,es-NI,Spanish - Nicaragua,20490,es-PR,Spanish - Puerto Rico,21514,es-US,Spanish - United States," & _
	"31748,zh-CHT,Chinese (Traditional) - China"
	Local $LanguageTableArray = StringSplit($LanguageTable, ",", 1)
	Local $LanguageCheck = _ArraySearch($LanguageTableArray, @OSLang)
	If $LanguageCheck = -1 Then
		Local $langXF = -1
	Else
		Local $langXF = $LanguageTableArray[$LanguageCheck + 1] & "," & $LanguageTableArray[$LanguageCheck + 2]
	EndIf
	Return $langXF
EndFunc   ;==>langX
;
;===============================================================================================================
; Function:		lang() - {LANG}
;===============================================================================================================
Func lang()
	If Not langX() = -1 Then
		Local $langF = StringSplit(langX(), ",", 1)
		$langF = $langF[2]
		$langF = StringRegExp($langF, "(?i)(.*) -", 1)
		$langF = $langF[0]
	Else
		Local $langF = -1
	EndIf
	Return $langF
EndFunc   ;==>lang
;
;===============================================================================================================
; Function:		locale() - {LOCALE}
;===============================================================================================================
Func locale()
	If Not langX() = -1 Then
		Local $localeF = StringSplit(langX(), ",", 1)
		$localeF = $localeF[1]
		$localeF = StringRegExp($localeF, "(?i)(.*)-", 1)
		$localeF = StringUpper($localeF[0])
	Else
		Local $localeF = -1
	EndIf
	Return $localeF
EndFunc   ;==>locale
;
;===============================================================================================================
; Function:		localename() - {LOCALENAME}
;===============================================================================================================
Func localename()
	If Not langX() = -1 Then
		Local $localenameF = StringSplit(langX(), ",", 1)
		$localenameF = $localenameF[1]
	Else
		Local $localenameF = -1
	EndIf
	Return $localenameF
EndFunc   ;==>localename
;
;===============================================================================================================
; Function:		localenameshort() - {LOCALENAME_SHORT}
;===============================================================================================================
Func localenameshort()
	If Not langX() = -1 Then
		Local $localenameshortF = StringSplit(langX(), ",", 1)
		$localenameshortF = $localenameshortF[1]
		$localenameshortF = StringRegExp($localenameshortF, "(?i)(.*)-", 1)
		$localenameshortF = StringLower($localenameshortF[0])
	Else
		Local $localenameshortF = -1
	EndIf
	Return $localenameshortF
EndFunc   ;==>localenameshort
;
;===============================================================================================================
; Function:		country() - {COUNTRY}
;===============================================================================================================
Func country()
	If Not langX() = -1 Then
		Local $countryF = StringSplit(langX(), ",", 1)
		$countryF = $countryF[2]
		$countryF = StringRegExp($countryF, "(?i)- (.*)", 1)
		$countryF = $countryF[0]
	Else
		Local $countryF = -1
	EndIf
	Return $countryF
EndFunc   ;==>country
;
; ===============================================================================================================
; Function:		CryptChange()|ClipboardButtonClick()|SaveLicenseButtonClick()|gapHomepageButtonClick()|CloseGUI()
; Source:		AutoIt help file "GUICtrlSetOnEvent" function reference example.
; Description:	Encryption and Decryption Module GUI Code Actions.
; Usage:		They will be called as the "OnEvent" actions happens.
; ===============================================================================================================
Func CryptChange()
	If GUICtrlRead($InputBox1, 0) <> "" And GUICtrlRead($Passwordbox, 0) <> "" Then
		Local $CryptCode = StringEncrypt(GUICtrlRead($ComboBox1, 0), GUICtrlRead($InputBox1, 0), GUICtrlRead($Passwordbox, 0))
		GUICtrlSetData($InputBox2, $CryptCode)
	Else
		GUICtrlSetData($InputBox2, "Read the encrypted or decrypted text here.")
	EndIf
EndFunc   ;==>CryptChange
Func ClipboardButtonClick()
	If GUICtrlRead($InputBox2, 0) <> "" And GUICtrlRead($InputBox2, 0) <> "Read the encrypted or decrypted text here." Then
		CryptChange()
		Local $CryptCodeToClipboard = GUICtrlRead($InputBox2, 0)
		ClipPut($CryptCodeToClipboard)
	EndIf
EndFunc   ;==>ClipboardButtonClick
Func SaveLicenseButtonClick()
	Local $LicenseToFile = GUICtrlRead($LicenseLabel, 0)
	Local $LicenseFile = FileOpen(@ScriptDir & "\License.txt", 42)
    If $LicenseFile = -1 Then
        MsgBox(64, "License - " & $ProgramName, "An error occurred when creating or reading the License file.")
        Return False
	Else
		FileWrite($LicenseFile, $LicenseToFile)
		FileClose($LicenseFile)
	EndIf
EndFunc   ;==>SaveLicenseButtonClick
Func gapHomepageButtonClick()
	ShellExecute("http://www.portablefreeware.com/forums/viewtopic.php?f=11&t=22129")
EndFunc   ;==>gapHomepageButtonClick
Func CloseGUI()
	CleanMUICache()
	CleanAppPaths()
	Exit
EndFunc   ;==>CloseGUI
;
; ===============================================================================================================
; Function:		HashFile()
; Source:		AutoIt help file "_Crypt_HashFile" function reference example.
; Description:	Returns the SHA1 hash for a file according to user instructions.
; Usage:		HashFile(Path to file to calculate the SHA1 hash)
; ===============================================================================================================
Func HashFile($hfFFilePath)
    _Crypt_Startup() ; Start the Crypt library.
    Local $hfFReturn = ""
    If FileExists($hfFFilePath) Then
		$hfFReturn = StringTrimLeft(_Crypt_HashFile($hfFFilePath, $CALG_SHA1), 2)
	Else
		$hfFReturn = -1
	EndIf
	_Crypt_Shutdown() ; Shutdown the Crypt library.
    Return $hfFReturn
EndFunc   ;==>HashFile
;
; ===============================================================================================================
; Function:		HashData()
; Source:		AutoIt help file "_Crypt_HashData" function reference example.
; Description:	Returns the SHA1 hash for input data according to user instructions.
; Usage:		HashData(Input data to calculate the SHA1 hash)
; ===============================================================================================================
Func HashData($hdFInputData)
    _Crypt_Startup() ; Start the Crypt library.
    Local $hdFReturn = StringTrimLeft(_Crypt_HashData($hdFInputData, $CALG_SHA1), 2)
	_Crypt_Shutdown() ; Shutdown the Crypt library.
    Return $hdFReturn
EndFunc   ;==>HashData
;
; ===============================================================================================================
; Function:		StringEncrypt()
; Source:		AutoIt help file "_Crypt_EncryptData" function reference example 2.
; Description:	Encrypt or decrypt data according to user instructions.
; Usage:		StringEncrypt(Encrypt or Decrypt flag, data to encrypt or decrypt, password)
; ===============================================================================================================
Func StringEncrypt($seFEncrypt, $seFData, $seFPassword)
    _Crypt_Startup() ; Start the Crypt library.
    Local $seFReturn = ""
    If $seFEncrypt = "Encrypt" Then ; If the flag is set to "Encrypt" then encrypt, otherwise decrypt.
        $seFReturn = "!@@!" & _Crypt_EncryptData($seFData, $seFPassword, $CALG_AES_256) & "!@@!"
    ElseIf $seFEncrypt = "Decrypt" Then
        $seFReturn = BinaryToString(_Crypt_DecryptData(StringReplace($seFData, "!@@!", ""), $seFPassword, $CALG_AES_256))
    EndIf
    _Crypt_Shutdown() ; Shutdown the Crypt library.
    Return $seFReturn
EndFunc   ;==>StringEncrypt
;
; ===============================================================================================================
; Function:		_SingletonPID()
; Source:		https://www.autoitscript.com/wiki/Snippets_%28_AutoIt_%29#SingletonPID
; Description:	Read the original function header below.
; Usage:		Read the original function header below.
; ===============================================================================================================
;
; #FUNCTION# ====================================================================================================
; Name ..........: _SingletonPID
; Description ...: Enforce a design paradigm where only one instance of the script may be running.
; Syntax ........: _SingletonPID($sOccurenceName[, $iFlag = 0])
; Parameters ....: $sOccurenceName      - String to identify the occurrence of the script.
;                  $iFlag               - [optional] Optional parameters. Default is 0.
;                  0 - Exit the script with the exit code -1 if another instance already exists.
;                  1 - Return the PID of the main executable and without exiting the script too.
; Return values .: Success - 0 No other process is running.
;                  Failure - The PID of the main executable.
; Author ........: guinness with initial ideas by Valik for _Singleton & KaFu for _EnforceSingleInstance.
; Example .......: Yes
; ===============================================================================================================
Func _SingletonPID(Const $sOccurenceName, Const $iFlag = 0)
    Local $hHandle = WinGetHandle($sOccurenceName)

    If @error Then
        AutoItWinSetTitle($sOccurenceName)
        $hHandle = WinGetHandle($sOccurenceName)
        ControlSetText($hHandle, '', ControlGetHandle($hHandle, '', 'Edit1'), @AutoItPID)
    Else
        If BitAND($iFlag, 1) Then
            Return Number(ControlGetText($hHandle, '', ControlGetHandle($hHandle, '', 'Edit1')))
        Else
            Exit -1
        EndIf
    EndIf

    Return 0
EndFunc   ;==>_SingletonPID
;
; ===============================================================================================================
; Function:		_ReduceMemory()
; Source:		http://www.autoitscript.com/forum/topic/13399-reducememory-udf/?p=683969
; Description:	Reduce memory usage of process ID (PID) given.
; Usage:		_ReduceMemory(PID of the process to reduce memory usage - Default "0" is the current process)
; ===============================================================================================================
Func _ReduceMemory($ProcID = 0)
	; Original version : w_Outer
	; modified by Rajesh V R to include process ID
	; modified by Prog@ndy to include process handle
	If $ProcID = 0 or ProcessExists($ProcID) = 0 Then ; No process id specified or process doesn't exist - use current process instead.
		Local $ai_GetCurrentProcess = DllCall("kernel32.dll", "ptr", "GetCurrentProcess")
		Local $ai_Return = DllCall("psapi.dll", "int", "EmptyWorkingSet", "ptr", $ai_GetCurrentProcess[0])
		Return $ai_Return[0]
	EndIf
	Local $ai_Handle = DllCall("kernel32.dll", "ptr", "OpenProcess", "int", 0x1f0fff, "int", False, "int", $ProcID)
	Local $ai_Return = DllCall("psapi.dll", "int", "EmptyWorkingSet", "ptr", $ai_Handle[0])
	DllCall("kernel32.dll", "int", "CloseHandle", "ptr", $ai_Handle[0])
	Return $ai_Return[0]
EndFunc   ;==>_ReduceMemory
;