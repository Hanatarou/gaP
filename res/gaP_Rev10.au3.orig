; Global
Global Const $gapFileHash = HashFile(@ScriptFullPath)
Global Const $ProgramName = "gaP: great! another Portabilizer"
Global Const $ProgramVersion = "1.1.5.0"
Global $gapExeDrive = ""
Global $gapExeDir = ""
Global $gapExeName = ""
Global $gapExeExt = ""
