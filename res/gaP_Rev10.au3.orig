			Sleep(100)
			CryptChange()
		WEnd
		; Encryption and Decryption Module GUI Code - End

	Case "-license"
		; License GUI - Start
		Opt("GUIOnEventMode", 1)
		Local $LicenseGUI = GUICreate("License and Disclaimer - " & $ProgramName, 530, 345, -1, -1)
		GUISetBkColor(0xFFFFFF, $LicenseGUI)
		Local $SaveLicenseButton = GUICtrlCreateButton("Save license", 200, 305, 130, 30)
		Local $LicenseLabel = GUICtrlCreateLabel("LICENSE" & @CRLF & @CRLF & "gaP is released as freeware. You are allowed to use; distribute gaP via floppy disk, CD-ROM, Internet, or in any other way, as long as you don't charge anything for this; and modify as you like it. The author is not liable for any damages arising from its use." & @CRLF & @CRLF & "This program is distributed as freeware in the hope that it will be useful, but without any warranty expressed or implied. You are free to modify gaP, but the author would like you to share your changes with him and do not take credit for work you did not do." & @CRLF & @CRLF & "DISCLAIMER" & @CRLF & @CRLF & "gaP is provided ""AS IS"" and ""WITH ALL FAULTS"" without any warranty, either expressed or implied, including, but not limited to, the implied warranties of merchantability and fitness for a particular purpose. The author will not be liable for any special, incidental, consequential or indirect damages due to loss of data or any other reason. The author makes no representations or warranties of any kind concerning the safety, suitability, lack of viruses, inaccuracies, typographical errors, or other harmful components of gaP." & @CRLF & @CRLF & "There are inherent dangers in the use of any software, and you are solely responsible for determining whether gaP is compatible with your equipment and other software installed on your equipment. You are also solely responsible for the protection of your equipment and backup of your data, and the author will not be liable for any damages you may suffer in connection with using, modifying or distributing gaP.", 8, 8, 515, 290)
		GUICtrlSetOnEvent($SaveLicenseButton, "SaveLicenseButtonClick")
