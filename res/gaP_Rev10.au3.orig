Func hour241()
	Local $hour241F = StringLeft(@HOUR, 1)
	If $hour241F = 0 Then
		$hour241F = StringRight(@HOUR, 1)
	Else
		$hour241F = @HOUR
	EndIf
	Return $hour241F
